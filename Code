        BookID INT,
        StudentName VARCHAR(100),
        IssueDate DATE
    );
    
    -- Clear table data in case it was left open in the current session
    TRUNCATE TABLE TempOutput;

    -- Open cursor
    OPEN cur;

    read_loop: LOOP
        FETCH cur INTO b_id, s_name, i_date;

        IF done = 1 THEN
            LEAVE read_loop;
        END IF;

        -- Collect rows inside the temporary table step by step
        INSERT INTO TempOutput VALUES (b_id, s_name, i_date);

    END LOOP;

    -- Close cursor
    CLOSE cur;

    -- Display the unified final data grid
    SELECT * FROM TempOutput;
    
    -- Drop temporary table to free up memory
    DROP TEMPORARY TABLE TempOutput;
END $$

DELIMITER ;

