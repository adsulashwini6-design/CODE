-- 2. CREATE TRIGGER FOR INSERT VALIDATION
DELIMITER $$

CREATE TRIGGER check_marks_before_insert
BEFORE INSERT ON StudentMarks
FOR EACH ROW
BEGIN
    -- Block execution if marks are completely out of bounds (0-100)
    IF NEW.Marks < 0 OR NEW.Marks > 100 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Data Entry Denied: Marks must be strictly between 0 and 100.';
    END IF;
END$$

DELIMITER ;


-- 3. CREATE TRIGGER FOR UPDATE VALIDATION
DELIMITER $$

CREATE TRIGGER check_marks_before_update
BEFORE UPDATE ON StudentMarks
FOR EACH ROW
BEGIN
    -- Block execution if an update attempts to set an invalid mark score
    IF NEW.Marks < 0 OR NEW.Marks > 100 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Update Denied: Marks must be strictly between 0 and 100.';
    END IF;
END$$

