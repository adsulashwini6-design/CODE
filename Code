-- Step 4: Create Stored Procedure using Cursor
DELIMITER $$

CREATE PROCEDURE ShowIssuedBooks()
BEGIN
    DECLARE done INT DEFAULT 0;
    DECLARE b_id INT;
    DECLARE s_name VARCHAR(100);
    DECLARE i_date DATE;

    -- Declare Cursor
    DECLARE cur CURSOR FOR
        SELECT BookID, StudentName, IssueDate FROM IssuedBooks;

    -- Declare Handler
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    -- Create a temporary table to consolidate loop output safely
    CREATE TEMPORARY TABLE IF NOT EXISTS TempOutput (
        BookID INT,
        StudentName VARCHAR(100),
        IssueDate DATE
    );
    
    -- Clear table data in case it was left open in the current session
    TRUNCATE TABLE TempOutput;

    -- Open cursor
    OPEN cur;

    read_loop: LOOP
        FETCH cur INTO b_id, s_name, i_date;

        IF done = 1 THEN
            LEAVE read_loop;
        END IF;

        -- Collect rows inside the temporary table step by step
        INSERT INTO TempOutput VALUES (b_id, s_name, i_date);

    END LOOP;

    -- Close cursor
    CLOSE cur;

    -- Display the unified final data grid
    SELECT * FROM TempOutput;
    
    -- Drop temporary table to free up memory
    DROP TEMPORARY TABLE TempOutput;
END $$

DELIMITER ;

-- Step 5: Execute Stored Procedure
CALL ShowIssuedBooks();
