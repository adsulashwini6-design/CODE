-- 3. CREATE THE STORED FUNCTION WITH A CURSOR
DELIMITER $$

CREATE FUNCTION CalculateTotalRevenue() 
RETURNS DECIMAL(12,2)
DETERMINISTIC
BEGIN
    -- Declare operational variables
    DECLARE done INT DEFAULT 0;
    DECLARE o_quantity INT;
    DECLARE p_price DECIMAL(10,2);
    DECLARE total_revenue DECIMAL(12,2) DEFAULT 0.00;

    -- Declare the cursor to join orders and book prices
    DECLARE cur CURSOR FOR 
        SELECT o.Quantity, b.Price 
        FROM Orders o
        INNER JOIN Books b ON o.ProductID = b.ProductID;

    -- Declare handler to terminate the loop when data runs out
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    -- Open the cursor
    OPEN cur;

    read_loop: LOOP
        -- Fetch row data into variables
        FETCH cur INTO o_quantity, p_price;

        -- Exit loop if no more records exist
        IF done = 1 THEN
            LEAVE read_loop;
        END IF;

        -- Calculate row total and add it to the running revenue tracker
        SET total_revenue = total_revenue + (o_quantity * p_price);
    END LOOP;

    -- Close the cursor to free memory
    CLOSE cur;

    -- Return the final calculated amount
    RETURN total_revenue;
END$$

DELIMITER ;


