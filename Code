-- 1. CREATE TABLES
CREATE TABLE Accounts (
    AccountID INT PRIMARY KEY,
    CustomerName VARCHAR(50) NOT NULL,
    Balance DECIMAL(10,2) NOT NULL
);

CREATE TABLE Transactions (
    TransactionID INT PRIMARY KEY,
    TransactionType VARCHAR(20) NOT NULL, -- 'Deposit' or 'Withdrawal'
    Amount DECIMAL(10,2) NOT NULL,
    AccountID INT,
    FOREIGN KEY (AccountID) REFERENCES Accounts(AccountID)
);


-- 2. CREATE TRIGGER: CHECK BALANCE BEFORE WITHDRAWAL
DELIMITER $$

CREATE TRIGGER check_balance_before_withdrawal
BEFORE INSERT ON Transactions
FOR EACH ROW
BEGIN
    DECLARE current_balance DECIMAL(10,2);

    -- Fetch the active balance of the target account
    SELECT Balance INTO current_balance
    FROM Accounts
    WHERE AccountID = NEW.AccountID;

    -- Block withdrawal if it exceeds available funds
    IF NEW.TransactionType = 'Withdrawal' AND NEW.Amount > current_balance THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Transaction Denied: Insufficient balance for withdrawal.';
    END IF;
END$$

DELIMITER ;


-- 3. CREATE TRIGGER: OPTIONAL AUTOMATION (Keeps balance updated after valid transactions)
DELIMITER $$

CREATE TRIGGER update_balance_after_transaction
AFTER INSERT ON Transactions
FOR EACH ROW
BEGIN
    IF NEW.TransactionType = 'Deposit' THEN
        UPDATE Accounts 
        SET Balance = Balance + NEW.Amount 
        WHERE AccountID = NEW.AccountID;
    ELSEIF NEW.TransactionType = 'Withdrawal' THEN
        UPDATE Accounts 
        SET Balance = Balance - NEW.Amount 
        WHERE AccountID = NEW.AccountID;
    END IF;
END$$

DELIMITER ;


