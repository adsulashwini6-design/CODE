-- 3. DQL: SELECTION & JOINS
-- Inner Join: Shows only students who have marks assigned
SELECT s.StudentName, sub.SubjectName, m.MarksObtained
FROM Marks m
INNER JOIN Student s ON m.StudentID = s.StudentID
INNER JOIN Subject sub ON m.SubjectID = sub.SubjectID;

-- Left Join: Shows all students, even if they have no marks (e.g., if a student missed exams)
SELECT s.StudentName, sub.SubjectName, m.MarksObtained
FROM Student s
LEFT JOIN Marks m ON s.StudentID = m.StudentID
LEFT JOIN Subject sub ON m.SubjectID = sub.SubjectID;

-- Right/Left Combo Join: Ensures all subjects are listed even if no one took them
SELECT s.StudentName, sub.SubjectName, m.MarksObtained
FROM Marks m
RIGHT JOIN Subject sub ON m.SubjectID = sub.SubjectID
LEFT JOIN Student s ON m.StudentID = s.StudentID;

-- Cross Join: Creates a grid of every possible student and subject combination
SELECT s.StudentName, sub.SubjectName
FROM Student s
CROSS JOIN Subject sub;

-- Aggregation Query: Finds the department with the highest total billing
SELECT Department, SUM(Amount) AS TotalBilling
FROM Billing
GROUP BY Department
ORDER BY TotalBilling DESC
LIMIT 1;




